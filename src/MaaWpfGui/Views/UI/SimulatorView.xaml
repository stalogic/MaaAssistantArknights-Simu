<UserControl
    x:Class="MaaWpfGui.Views.UI.SimulatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:taskQueue="clr-namespace:MaaWpfGui.Views.UserControl.TaskQueue"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type ui_vms:SimulatorViewModel}}"
    d:DesignHeight="800"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <hc:ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- AI Control Panel (all controls merged) -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,10"
                Padding="15"
                Background="{DynamicResource RegionBrushOpacity25}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="AI Control Panel" />

                    <!-- Connection -->
                    <DockPanel Margin="0,5">
                        <TextBlock Width="140" VerticalAlignment="Center" Text="AI Enable:" />
                        <CheckBox IsChecked="{Binding AiEnabled}" Content="Enable AI Connection" />
                    </DockPanel>
                    <DockPanel Margin="0,5">
                        <TextBlock Width="140" VerticalAlignment="Center" Text="AI Endpoint:" />
                        <TextBox
                            Text="{Binding AiEndpoint, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding AiEnabled}"
                            hc:InfoElement.Placeholder="http://localhost:8765" />
                    </DockPanel>
                    <DockPanel Margin="0,5">
                        <TextBlock Width="140" VerticalAlignment="Center" Text="Status:" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="{Binding AiStatus}" />
                            <Button
                                Margin="10,0,0,0"
                                Padding="5,2"
                                Command="{s:Action CheckAiConnection}"
                                Content="Check" />
                        </StackPanel>
                    </DockPanel>

                    <Separator Margin="0,10" />

                    <!-- Trajectory Logging -->
                    <DockPanel Margin="0,5">
                        <TextBlock Width="140" VerticalAlignment="Center" Text="Record Trajectory:" />
                        <CheckBox IsChecked="{Binding TrajectoryLogging}" Content="Record trajectory" />
                    </DockPanel>
                    <DockPanel Margin="0,5">
                        <TextBlock Width="140" VerticalAlignment="Center" Text="Log Directory:" />
                        <TextBox
                            Text="{Binding TrajectoryDir, UpdateSourceTrigger=PropertyChanged}"
                            hc:InfoElement.Placeholder="debug/trajectory" />
                    </DockPanel>

                    <Separator Margin="0,10" />

                    <!-- AI Decision Switches -->
                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="Bold"
                        Text="AI Decisions:" />
                    <WrapPanel>
                        <CheckBox Margin="0,3,10,3" IsChecked="{Binding AiRecruit}" Content="Recruit (招募)" />
                        <CheckBox Margin="0,3,10,3" IsChecked="{Binding AiBattle}" Content="Battle (战斗)" />
                        <CheckBox Margin="0,3,10,3" IsChecked="{Binding AiShopping}" Content="Shopping (商店)" />
                        <CheckBox Margin="0,3,10,3" IsChecked="{Binding AiEncounter}" Content="Encounter (遭遇)" />
                        <CheckBox Margin="0,3,10,3" IsChecked="{Binding AiRouting}" Content="Routing (路线)" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Roguelike Settings -->
            <Border
                Grid.Row="1"
                Margin="0,0,0,10"
                Padding="15"
                Background="{DynamicResource RegionBrushOpacity25}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <taskQueue:RoguelikeSettingsUserControl DataContext="{x:Static ui_vms:TaskQueueViewModel.RoguelikeTask}" />
            </Border>

            <!-- Start Button -->
            <Button
                Grid.Row="2"
                Width="200"
                Height="40"
                Margin="0,10"
                HorizontalAlignment="Center"
                Command="{s:Action StartRoguelike}"
                Content="Start Roguelike"
                FontSize="16" />
        </Grid>
    </hc:ScrollViewer>
</UserControl>
